{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "moduleResolution": "bundler",
    "noImplicitAny": false,
    "strict": false
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.d.ts"]
}
